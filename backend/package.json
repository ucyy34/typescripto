{
  "name": "dostan-marketplace-backend",
  "version": "1.0.0",
  "description": "Production-ready marketplace backend for 1000-2000 stores with 50K daily traffic",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "dev:ts": "dotenv -e .env.ts -- nodemon --config nodemon.json src/bootstrap.ts",
    "build": "tsc",
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "echo 'Use seed:dev for safety' && exit 1",
    "seed:dev": "dotenv -e .env.ts -- node src/scripts/clean-and-seed.js",
    "seed:siftah": "node src/scripts/seed-siftah-test.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,json}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --project tsconfig.strict.json --noEmit",
    "smoke:reset": "dotenv -e .env.ts -- node src/scripts/reset-test-data.js",
    "smoke:test": "npm run smoke:reset && dotenv -e .env.ts -- node src/scripts/smoke-test-ts.js",
    "guest:cleanup": "dotenv -e .env.ts -- node src/scripts/cleanup-guest-carts.js"
  },
  "keywords": [
    "marketplace",
    "ecommerce",
    "nodejs",
    "express",
    "postgresql"
  ],
  "author": "Dostan Marketplace",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.1",
    "slugify": "^1.6.6",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/sequelize": "^4.28.20",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "sequelize-cli": "^6.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
