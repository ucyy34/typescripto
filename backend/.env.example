# ========================================
# DOSTAN MARKETPLACE - CONFIGURATION
# Copy this file to .env and update values
# ========================================

# Server Configuration
NODE_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
API_VERSION=v1

# Database Configuration
DATABASE_URL=postgres://username:password@localhost:5432/database_name
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password
DB_DIALECT=postgres

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration (GENERATE NEW SECRETS!)
JWT_SECRET=your_jwt_secret_here_at_least_64_characters
JWT_EXPIRE=1h
JWT_REFRESH_SECRET=your_refresh_secret_here_at_least_64_characters
JWT_REFRESH_EXPIRE=7d

# Security
COOKIE_SECRET=your_cookie_secret_here
SESSION_SECRET=your_session_secret_here
BCRYPT_ROUNDS=12

# CORS Configuration
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# Admin User (Auto-created on seed)
ADMIN_EMAIL=admin@dostanmarket.com
ADMIN_PASSWORD=change_this_password

# Logging
LOG_LEVEL=debug
