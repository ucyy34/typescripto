# Server Configuration
NODE_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
API_VERSION=v1

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dostan_marketplace
DB_USER=postgres
DB_PASSWORD=your_password_here
DATABASE_URL=postgres://user:password@localhost:5432/dostan_marketplace
DB_DIALECT=postgres
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=1h
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_REFRESH_EXPIRE=7d

# Cookie Configuration
COOKIE_SECRET=your_cookie_secret_change_this

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# AWS S3 / MinIO Configuration
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-central-1
S3_BUCKET_NAME=dostan-marketplace

# MinIO (Local Development)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=Dostan Marketplace <noreply@dostanmarket.com>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Bull Queue (Redis-based)
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379

# Application Settings
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp
MAX_FILES_PER_UPLOAD=5

# Shipping
SHIPPING_PROVIDER=mock
SHIPPING_PERSIST=false
SHIPPING_TRACKING_POLL=false

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Admin Default User (Auto-created on first run)
ADMIN_EMAIL=admin@dostanmarket.com
ADMIN_PASSWORD=Admin@123456

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Payment Gateway (İyzico - Turkey)
IYZICO_API_KEY=your_iyzico_api_key
IYZICO_SECRET_KEY=your_iyzico_secret_key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Session
SESSION_SECRET=your_session_secret_change_this
SESSION_EXPIRE=86400000

# Security
BCRYPT_ROUNDS=12
